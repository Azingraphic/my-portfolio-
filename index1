<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Azin | Video Editor & Thumbnail Designer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #121212;
            color: #ffffff;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background-image: radial-gradient(circle at 50% -20%, #2a2a2a, #121212);
        }

        .header { text-align: center; padding: 60px 20px 20px; }
        h1 { font-size: 3.5rem; letter-spacing: 3px; margin-bottom: 10px; color: #f5a623; text-shadow: 0 0 20px rgba(245, 166, 35, 0.4); }
        h2 { font-size: 1.2rem; font-weight: 400; color: #aaaaaa; margin-bottom: 20px; }
        .bio { font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px; color: #dddddd; max-width: 600px; margin-left: auto; margin-right: auto; padding: 0 20px; }

        .links { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; margin-bottom: 40px; }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; background-color: #f5a623; color: #121212;
            text-decoration: none; font-weight: bold; border-radius: 5px;
            transition: all 0.3s ease;
        }
        .btn:hover { background-color: #ffffff; transform: translateY(-3px); box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2); }
        .btn-outline { background-color: transparent; color: #f5a623; border: 2px solid #f5a623; }
        .btn-outline:hover { background-color: #f5a623; color: #121212; box-shadow: 0 5px 15px rgba(245, 166, 35, 0.4); }

        .swiper { width: 100%; padding: 20px 20px 60px; }
        .swiper-slide {
            background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37); overflow: hidden;
            transition: transform 0.3s ease; display: flex; flex-direction: column;
        }
        .swiper-slide:hover { transform: translateY(-5px); border-color: rgba(245, 166, 35, 0.5); }

        .video-container { position: relative; width: 100%; padding-bottom: 56.25%; }
        .video-container iframe, .video-container img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; object-fit: cover; }

        .swiper-slide.vertical-slide { max-width: 350px; margin: 0 auto; }
        .vertical-container { position: relative; width: 100%; padding-bottom: 177.77%; }
        .vertical-container iframe, .vertical-container img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; object-fit: cover; }

        .slide-content { padding: 20px; text-align: center; flex-grow: 1; }
        .slide-content h3 { margin: 0 0 10px 0; color: #fff; }
        .slide-content p { margin: 0; color: #aaa; font-size: 0.9rem; }

        .swiper-button-next, .swiper-button-prev { color: #f5a623 !important; }
        .swiper-pagination-bullet-active { background-color: #f5a623 !important; }

        .footer { text-align: center; padding: 40px 20px; color: #888; font-size: 0.9rem; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 20px; }
        .social-links { margin-bottom: 20px; display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }

        .social-icon {
            display: flex; justify-content: center; align-items: center;
            width: 50px; height: 50px; background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 50%;
            color: #f5a623; font-size: 1.5rem; text-decoration: none; transition: all 0.3s ease;
        }
        .social-icon:hover { transform: translateY(-5px) scale(1.1); box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5); color: #fff; }
        
        .social-icon.instagram:hover { background: #E1306C; border-color: #E1306C; }
        .social-icon.telegram:hover { background: #0088cc; border-color: #0088cc; }
        .social-icon.youtube:hover { background: #FF0000; border-color: #FF0000; }
        .social-icon.website:hover { background: #f5a623; border-color: #f5a623; color: #121212; }
        .social-icon.email:hover { background: #EA4335; border-color: #EA4335; }
    </style>
</head>
<body>

    <div class="header">
        <h1>AZIN</h1>
        <h2>Video Editor & Thumbnail Designer</h2>
        <p class="bio">
            Welcome to my creative space. I specialize in motion graphics, video editing, and eye-catching thumbnail design. Check out my latest work below.
        </p>
        
        <div class="links">
            <a href="https://youtube.com/@azingraphic" target="_blank" class="btn">
                <i class="fa-brands fa-youtube"></i> View Showreel
            </a>
            <a href="https://Azingraphic.com" target="_blank" class="btn btn-outline">
                <i class="fa-solid fa-globe"></i> My Website
            </a>
        </div>
    </div>

    <div class="swiper mySwiper">
        <div class="swiper-wrapper">
            
            <!-- آیتم اول: شورت واقعی شما -->
            <div class="swiper-slide vertical-slide">
                <div class="vertical-container">
                    <iframe src="https://www.youtube.com/embed/zAhUIW_Ceh4" allowfullscreen></iframe>
                </div>
                <div class="slide-content">
                    <h3>Short Form Video</h3>
                    <p>Vertical edit optimized for Reels & Shorts.</p>
                </div>
            </div>

            <!-- آیتم دوم: تامبنیل اول شما -->
            <div class="swiper-slide">
                <div class="video-container">
                    <img src="https://raw.githubusercontent.com/Azingraphic/my-portfolio-/main/Thumbnail_1.png" alt="Thumbnail Design 1">
                </div>
                <div class="slide-content">
                    <h3>Clear Skin Thumbnail</h3>
                    <p>High CTR thumbnail design for a health channel.</p>
                </div>
            </div>

            <!-- آیتم سوم: تامبنیل دوم شما -->
            <div class="swiper-slide">
                <div class="video-container">
                    <img src="https://raw.githubusercontent.com/Azingraphic/my-portfolio-/main/Thumbnail_2.png" alt="Thumbnail Design 2">
                </div>
                <div class="slide-content">
                    <h3>Fear of Writing Thumbnail</h3>
                    <p>Creative concept design for a writing channel.</p>
                </div>
            </div>

            <!-- آیتم چهارم: تامبنیل سوم شما -->
            <div class="swiper-slide">
                <div class="video-container">
                    <img src="https://raw.githubusercontent.com/Azingraphic/my-portfolio-/main/Thumbnail_4.png" alt="Thumbnail Design 3">
                </div>
                <div class="slide-content">
                    <h3>Edit Create Grow Thumbnail</h3>
                    <p>Inspirational design for a video editing channel.</p>
                </div>
            </div>

        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-pagination"></div>
    </div>

    <div class="footer">
        <div class="social-links">
            <a href="https://instagram.com/azingraphic" target="_blank" class="social-icon instagram" title="Instagram">
                <i class="fa-brands fa-instagram"></i>
            </a>
            <a href="https://t.me/azingraphic1" target="_blank" class="social-icon telegram" title="Telegram">
                <i class="fa-brands fa-telegram"></i>
            </a>
            <a href="https://youtube.com/@azingraphic" target="_blank" class="social-icon youtube" title="YouTube">
                <i class="fa-brands fa-youtube"></i>
            </a>
            <a href="https://Azingraphic.com" target="_blank" class="social-icon website" title="Website">
                <i class="fa-solid fa-globe"></i>
            </a>
            <a href="mailto:azingraphic60@gmail.com" class="social-icon email" title="Email">
                <i class="fa-solid fa-envelope"></i>
            </a>
        </div>
        <p>&copy; 2024 Azin. All rights reserved.</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mySwiper", {
            slidesPerView: 1,
            spaceBetween: 30,
            loop: true,
            pagination: { el: ".swiper-pagination", clickable: true },
            navigation: { nextEl: ".swiper-button-next", prevEl: ".swiper-button-prev" },
            breakpoints: { 768: { slidesPerView: 2 }, 1024: { slidesPerView: 3 } },
        });
    </script>

</body>
</html>
